{
  "name": "proorgazm",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web -c magenta,cyan \"npm:server:dev\" \"vite\"",
    "server": "node --no-warnings=ExperimentalWarning server/index.js",
    "server:dev": "node --no-warnings=ExperimentalWarning --watch server/index.js",
    "build": "vite build",
    "start": "npm run build && npm run server",
    "images": "node scripts/optimize-images.mjs",
    "import:articles": "node scripts/import-articles.mjs"
  },
  "dependencies": {
    "@gsap/react": "2.1.1",
    "express": "^4.21.2",
    "framer-motion": "11.11.17",
    "gsap": "3.12.5",
    "lenis": "^1.1.18",
    "multer": "^1.4.5-lts.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "6.28.0",
    "sharp": "^0.33.5"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "4.3.4",
    "concurrently": "^9.1.0",
    "vite": "6.0.3"
  }
}